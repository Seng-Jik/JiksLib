<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <PropertyGroup>

    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>

  </PropertyGroup>

  <!-- 代码质量与发布行为：本文件被 JiksLib、JiksLib.Test、JiksLib.Benchmark 三个项目共同继承 -->
  <PropertyGroup>

    <!-- 启用内置 .NET 代码分析器；net48 / netstandard2.1 目标默认不启用，这里一并打开 -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      采用最严格的 latest-all 规则集，让所有可用的 CA 规则都参与检查。
      与库的公开 API 设计、零分配目标或 net48 / netstandard2.1 兼容性冲突的规则
      在 .editorconfig 中逐条关闭并注明原因；其余规则在本仓库保持 0 warning。
    -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <!-- 警告视为错误，避免新增编译告警进入主干 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      分析器（CAxxxx）只报告、不阻断构建：latest-all 会随 SDK 升级引入新规则，
      把它当成错误会让构建在 SDK 更新时意外中断。当前代码在 latest-all 下为 0 warning，
      新增告警由构建输出与 review 保证。编译器告警（CSxxxx）仍然视为错误。
    -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>

    <!-- 可重现构建；CI 下额外启用持续集成构建模式 -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!--
      ContinuousIntegrationBuild 会打开确定性源码路径映射（PathMap），
      coverlet.collector 6.x 无法把 PDB 中的映射路径还原成真实源码路径，
      CI 上会产出空覆盖率报告；这里关闭路径映射，二进制仍保持 Deterministic。
    -->
    <DeterministicSourcePaths>false</DeterministicSourcePaths>

    <!-- 生成可移植 PDB，符号包（snupkg）才有内容可打包；embedded 时 snupkg 会因无内容报 NU5017 -->
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>

  </PropertyGroup>
</Project>
