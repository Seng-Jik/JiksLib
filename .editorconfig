# JiksLib 编辑器与分析器配置
# 该文件同时服务于 IDE 格式化与 CI 的 `dotnet format --verify-no-changes`。

root = true

[*]
charset = utf-8
# 全仓统一 LF；CI 在 Windows/Linux/macOS 上都执行 dotnet format，
# 显式指定可以避免各平台默认换行不同导致的误报。
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[*.{yml,yaml,json,md}]
indent_size = 2

[*.cs]
indent_size = 4

# Unity 兼容约定（无法由分析器强制，靠 review 保证）：
# 对可能为 UnityEngine.Object 的值，不要使用 `is null` / `is not null`，
# 因为模式匹配不会走 Unity 重载的 == / !=，无法识别"已销毁对象"；
# 统一使用 `== null` / `!= null`。同理，避免对这类值使用 `??` 与 `?.`。

# --- 分析器规则取舍 -------------------------------------------------------
# 以下规则的建议依赖 .NET 7+ API 或会改变公开 API 形态，而本库还需兼容
# net48 / netstandard2.1，因此保持关闭；其余 CA 规则仍以 warning 呈现。

# CS1591 已在 csproj 中通过 NoWarn 关闭（公开成员文档后续补齐）。
dotnet_diagnostic.CA1014.severity = none   # 程序集需标记 CLSCompliant：本库不做 CLS 承诺
dotnet_diagnostic.CA1822.severity = none   # 成员可设为 static：部分实例方法为保持 API 对称性而保留
dotnet_diagnostic.CA1510.severity = none   # 建议 ArgumentNullException.ThrowIfNull（.NET 7+）
dotnet_diagnostic.CA1512.severity = none   # 建议 ArgumentOutOfRangeException.ThrowIfNegative（.NET 7+）
dotnet_diagnostic.CA1847.severity = none   # 建议 string.Contains(char)（net48 无此重载）
dotnet_diagnostic.CA2249.severity = none   # 同上，建议 Contains 代替 IndexOf（net48 无 char 重载）
