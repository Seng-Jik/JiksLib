<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0;net48</TargetFrameworks>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <!-- 测试工程不参与发布，关闭分析器以避免大量测试风格告警淹没构建输出 -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <IsPackable>false</IsPackable>

    <!--
      默认引用与当前目标框架相同的库产物。
      当显式传入 -p:JiksLibTargetFramework=netstandard2.1 时，net10/net11 会改为引用
      库的 netstandard2.1 产物，从而用同一套测试覆盖 Unity 目标；此时期待 NETCOREAPP
      独有 API 的用例由 JIKS_NS21 符号排除。
    -->
    <JiksLibTargetFramework Condition="'$(JiksLibTargetFramework)' == ''">$(TargetFramework)</JiksLibTargetFramework>
    <DefineConstants Condition="'$(JiksLibTargetFramework)' == 'netstandard2.1'">$(DefineConstants);JIKS_NS21</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!-- net48 无法消费 netstandard2.1 产物，始终引用 net48 版本 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="../JiksLib/JiksLib.csproj" />
  </ItemGroup>

  <!-- net10/net11：由 JiksLibTargetFramework 决定引用哪个库产物 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <ProjectReference
      Include="../JiksLib/JiksLib.csproj"
      SetTargetFramework="TargetFramework=$(JiksLibTargetFramework)" />
  </ItemGroup>

</Project>
